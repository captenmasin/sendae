{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "sendae/sendae",
    "type": "project",
    "description": "Offline-first personal social publishing with a hosted Laravel publisher.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.17",
        "laravel/mcp": "^0.9.4",
        "laravel/tinker": "^3.0",
        "nativephp/desktop": "^2.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.7",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "pnpm install --frozen-lockfile",
            "pnpm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "native:dev": [
            "Composer\\Config::disableProcessTimeout",
            "node vendor/nativephp/desktop/resources/electron/node_modules/electron/install.js",
            "@php artisan native:migrate --no-interaction",
            "pnpm exec concurrently -k -c \"#93c5fd,#c4b5fd\" \"php artisan native:run --no-interaction --no-dependencies\" \"pnpm run dev\" --names=app,vite"
        ],
        "desktop:setup": [
            "@php artisan native:install --no-interaction",
            "node scripts/prepare-desktop.mjs",
            "@php artisan native:migrate --no-interaction",
            "pnpm run build"
        ],
        "desktop:dev": [
            "Composer\\Config::disableProcessTimeout",
            "node vendor/nativephp/desktop/resources/electron/node_modules/electron/install.js",
            "@php artisan native:migrate --no-interaction",
            "@php artisan native:run --no-dependencies"
        ],
        "desktop:build": [
            "node scripts/prepare-desktop.mjs",
            "@putenv CSC_IDENTITY_AUTO_DISCOVERY=false",
            "@php artisan native:build mac arm64 --no-interaction"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
